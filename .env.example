# Neon Console > Project > Connect > copy the pooled connection string
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require
# Generate a unique random secret of at least 40 characters
SESSION_SECRET=replace-with-a-long-random-secret-at-least-40-characters
RESEND_API_KEY=re_xxxxxxxxx
CERT_EMAIL=your-verified-recipient@example.com
MAIL_FROM=CSDSA Learning Academy <your-verified-sender@example.com>
# Display-only PayShap identifier. This does NOT verify payments.
PAYSHAP_ID=your-approved-pay-shap-identifier
SITE_URL=https://your-vercel-domain.vercel.app
# Comma-separated emails that always have administrator access
ADMIN_EMAILS=your@email.example
